{
  "name": "ptero",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "pnpm --filter @ptero/cli build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages",
    "lint:fix": "eslint packages --fix",
    "format": "prettier --write packages",
    "format:check": "prettier --check packages",
    "test": "pnpm -r test",
    "test:docker": "docker compose -f test/docker/docker-compose.yml up --build --abort-on-container-exit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.0"
  }
}
