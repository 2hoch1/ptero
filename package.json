{
  "name": "ptero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile dist/ptero",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:docker": "docker compose -f test/docker/docker-compose.yml up --build --abort-on-container-exit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.0"
  }
}
